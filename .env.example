# ── FACE RECOGNITION ─────────────────────────────────────
# Model options: VGG-Face | Facenet | Facenet512 | ArcFace | DeepFace
FACE_MODEL=ArcFace

# Detector options: opencv | ssd | dlib | mtcnn | retinaface
FACE_DETECTOR=retinaface

# Distance metric: cosine | euclidean | euclidean_l2
FACE_DISTANCE_METRIC=cosine

# Recognition threshold (lower = stricter match)
# ArcFace + cosine: recommended 0.68
FACE_THRESHOLD=0.68

# ── GEOFENCE ─────────────────────────────────────────────
# Default max distance in metres for Basic plan schools
DEFAULT_MAX_DISTANCE_METRES=100

